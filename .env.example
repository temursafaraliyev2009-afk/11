# ==========================================
# Savatchi POS & Online Shop Environment
# ==========================================

# Supabase Configuration (Asosiy ma'lumotlar bazasi va autentifikatsiya)
# Olish joyi: Supabase Dashboard -> Project Settings -> API
# URL: Project URL (masalan: https://your-project.supabase.co)
# ANON_KEY: Project API keys -> anon/public (publishable) key
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Google Cloud OAuth 2.0 / Google Identity Services (GIS) Client ID
# Olish joyi: https://console.cloud.google.com -> APIs & Services -> Credentials -> Create Credentials -> OAuth Client ID -> Web Application
# Authorized JavaScript origins: http://localhost:5173, http://localhost:3000
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Backend API URL (agar backend alohida portda bo'lsa)
VITE_API_BASE_URL=http://localhost:5000

# Firebase Configuration for Savatchi (Eski autentifikatsiya varianti)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
